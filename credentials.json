const { google } = require('googleapis');
const path = require('path');

// 1. Authenticate using the Service Account JSON key file
const auth = new google.auth.GoogleAuth({
  keyFile: path.join(__dirname, 'credentials.json'),
  // The 'spreadsheets' scope gives full write/create permissions to eliminate the error
  scopes: ['https://googleapis.com', 'https://googleapis.com'],
});

async function createRegistrationSheet(userData) {
  try {
    const sheets = google.sheets({ version: 'v4', auth });
    const drive = google.drive({ version: 'v3', auth });

    // Step A: Create a brand new spreadsheet metadata object
    const resource = {
      properties: {
        title: `Registration - ${userData.email}`,
      },
    };

    console.log('Authenticating with Google...');
    console.log('📊 Creating Google Sheet...');

    const spreadsheet = await sheets.spreadsheets.create({
      resource,
      fields: 'spreadsheetId',
    });

    const sheetId = spreadsheet.data.spreadsheetId;

    // Step B: Move the newly created sheet into your shared Google Drive folder
    // (If you don't do this, the file will be hidden inside the service account's private drive)
    await drive.files.update({
      fileId: sheetId,
      addParents: 1Tlcuf-uQApgHLI7rSfays9NmOa728XDXcWySSY,
      fields: 'id, parents',
    });

    // Step C: Format Row 1 with Headers and Row 2 with User Data
    const values = [
      ['Timestamp', 'First Name', 'Last Name', 'Email'], // Headers
      [new Date().toISOString(), userData.firstName, userData.lastName, userData.email] // Data
    ];

    await sheets.spreadsheets.values.update({
      spreadsheetId: sheetId,
      range: 'Sheet1!A1',
      valueInputOption: 'RAW',
      resource: { values },
    });

    console.log(`✅ Success! Sheet created and populated. ID: ${sheetId}`);
    return sheetId;

  } catch (error) {
    console.error('❌ Error executing operation:', error.message);
  }
}

// Simulated data payload from your account signup form
const mockNewUser = {
  firstName: 'Jane',
  lastName: 'Doe',
  email: 'jane.doe@example.com'
};

// Run the automation function
createRegistrationSheet(mockNewUser);
